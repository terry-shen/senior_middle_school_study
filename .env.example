# 数据库配置
# PostgreSQL 连接字符串
DATABASE_URL="postgresql://math_user:your_password@localhost:5432/math_learning"

# JWT 配置
# 用于生成和验证 JWT Token，请修改为随机字符串
JWT_SECRET="change-this-to-a-random-secret-key-at-least-32-characters"

# 服务配置
PORT=3000
NODE_ENV=development

# 前端地址（用于 CORS 配置）
FRONTEND_URL="http://localhost:5173"

# LLM 配置（可选）
# 如使用云端模型，配置以下选项
# LLM_PROVIDER=ollama  # ollama, zhipu, qwen, openai
# LLM_ENDPOINT=http://localhost:11434
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=  # 云端模型需要

# 日志级别
LOG_LEVEL=info

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB