# Nginx 配置示例
# 高中数学学习系统 - 生产环境部署
#
# 使用方法:
# 1. 复制此文件到 /etc/nginx/sites-available/math-learning
# 2. 创建软链接: sudo ln -s /etc/nginx/sites-available/math-learning /etc/nginx/sites-enabled/
# 3. 测试配置: sudo nginx -t
# 4. 重载配置: sudo nginx -s reload

server {
    listen 80;
    server_name your-domain.com;  # 替换为您的域名

    # 重定向到 HTTPS（可选）
    # return 301 https://$server_name$request_uri;

    # 后端 API 代理
    location /api {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # 前端静态文件
    location / {
        root /var/www/math-learning/frontend/dist;  # 替换为前端构建目录
        try_files $uri $uri/ /index.html;
        
        # 静态文件缓存
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # 健康检查端点
    location /health {
        proxy_pass http://localhost:3000/health;
        access_log off;
    }

    # 日志配置
    access_log /var/log/nginx/math-learning-access.log;
    error_log /var/log/nginx/math-learning-error.log;

    # 客户端请求限制
    client_max_body_size 10M;
}

# HTTPS 配置（可选）
