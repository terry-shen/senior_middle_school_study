// ===== Mock Exam Models =====

// 统一考试会话（合并 MockExam + Exam + GeneratedExam）
// 学科字典（全学科维度）
model Subject {
  id        Int      @id @default(autoincrement())
  code      String   @unique // math, chinese, english, physics...
  name      String // 数学
  icon      String? // 图标（emoji 或 icon 名）
  color     String? // 主题色（如 #3b82f6）
  order     Int      @default(0) // 排序
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  textbooks       Textbook[]

  @@map("subjects")
}

// 考试会话分配（班级/学生归属）

// 统一答题记录（合并 ExamRecord + AnswerRecord）
// 整卷模式不创建 ExamSubmission（只关联 AnswerSheet）

// 学生答题纸（整卷/在线测验/模拟考试结束后上传，老师离线阅卷批注）

model Session {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  token     String   @unique // JWT token
  expiresAt DateTime @map("expires_at") // 过期时间
  createdAt DateTime @default(now()) @map("created_at")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([token])
  @@map("sessions")
}

