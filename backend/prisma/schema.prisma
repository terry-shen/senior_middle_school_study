// ===== Netdisk Integration =====
model NetdiskConfig {
  id            Int       @id @default(autoincrement())
  appKey        String    @map("app_key")
  appSecret     String    @map("app_secret")
  signKey       String?   @map("sign_key")
  accessToken   String?   @map("access_token")
  refreshToken  String?   @map("refresh_token")
  tokenExpireAt DateTime? @map("token_expire_at")
  netdiskUk     String?   @map("netdisk_uk")
  redirectUri   String?   @map("redirect_uri") // 授权回调页，必须与百度开放平台安全设置登记完全一致；空则用默认 http://localhost:3000/api/netdisk/callback
  status        String    @default("unconfigured") // unconfigured | unbound | bound | expired
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("netdisk_config")
}

// ===== Video / Teaching Resource Library =====

// ===== Chapter Taxonomy: 教材 -> 章 -> 节 =====
model Textbook {
  id        Int      @id @default(autoincrement())
  subjectId Int      @map("subject_id")
  name      String // 必修第一册 / 必修第二册 / 选择性必修第一册 ...
  edition   String   @default("人教A")
  grade     String? // 高一上 / 高一下 / 高二上 ...
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@unique([subjectId, edition, name])
  @@index([subjectId, order])
  @@map("textbooks")
}

model Chapter {
  id         Int      @id @default(autoincrement())
  textbookId Int      @map("textbook_id")
  order      Int      @default(0)
  title      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  textbook Textbook  @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([textbookId, order])
  @@index([textbookId, order])
  @@map("chapters")
}

model Section {
  id        Int      @id @default(autoincrement())
  chapterId Int      @map("chapter_id")
  order     Int      @default(0)
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chapter          Chapter                   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  netdiskAssets    NetdiskAsset[]            @relation("SectionNetdiskAssets")
  learningProgress StudentLearningProgress[] @relation("SectionLearningProgress")

  @@unique([chapterId, order])
  @@index([chapterId, order])
  @@map("sections")
  assetOpens StudentAssetOpen[] @relation("SectionAssetOpens")

}

// ===== 网盘资源索引（M3）=====
model NetdiskAsset {
  id                Int       @id @default(autoincrement())
  fsId              BigInt?   @map("fs_id")
  path              String    @unique
  name              String
  ext               String?
  size              BigInt?
  mtime             DateTime?
  assetKind         String    @default("other") @map("asset_kind") // lecture|ppt|answer|practice|exam|plan|audio|video|image|junk|other
  audience          String    @default("both") // student|teacher|both
  year              Int?
  region            String?
  series            String?
  sectionId         Int?      @map("section_id")
  mapSource         String    @default("none") @map("map_source") // auto|manual|none
  mapConfirmed      Boolean   @default(false) @map("map_confirmed")
  isPinned          Boolean   @default(false) @map("is_pinned")
  status            String    @default("active") // active|archive|ignored
  candidateSections String?   @map("candidate_sections") // JSON [{sectionId, title, score}]
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  section          Section?                  @relation("SectionNetdiskAssets", fields: [sectionId], references: [id], onDelete: SetNull)
  learningProgress StudentLearningProgress[] @relation("AssetLearningProgress")

  @@index([sectionId])
  @@index([assetKind])
  @@index([audience])
  @@index([status])
  @@index([mapConfirmed])
  @@map("netdisk_assets")
  opens StudentAssetOpen[] @relation("AssetOpens")

}

// ===== 网盘扫描状态（单行，用于断点续扫）=====
model NetdiskScanState {
  id          Int       @id @default(1)
  status      String    @default("idle") // idle|running|paused|done|error
  queue       String    @default("[]") // JSON: 待扫描目录列表
  currentDir  String?   @map("current_dir")
  scannedDirs Int       @default(0) @map("scanned_dirs")
  totalFiles  Int       @default(0) @map("total_files")
  lastError   String?   @map("last_error")
  startedAt   DateTime? @map("started_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("netdisk_scan_state")
}

// ===== 学生学习进度（M4：最近学习的节与资源）=====
model StudentLearningProgress {
  id        Int      @id @default(autoincrement())
  studentId Int      @unique @map("student_id")
  sectionId Int      @map("section_id")
  assetId   Int?     @map("asset_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section       @relation("SectionLearningProgress", fields: [sectionId], references: [id], onDelete: Cascade)
  asset   NetdiskAsset? @relation("AssetLearningProgress", fields: [assetId], references: [id], onDelete: SetNull)

  @@index([sectionId])
  @@map("student_learning_progress")
}

// ===== AI 助理导航 =====

// 可导航的在线 AI 站点（介绍 + 跳转地址，由管理员维护）
model AiAssistant {
  id          Int      @id @default(autoincrement())
  code        String   @unique // doubao / deepseek / workbuddy
  name        String
  url         String   @default("")
  icon        String?
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("ai_assistants")
}

model StudentAssetOpen {
  id        Int      @id @default(autoincrement())
  studentId Int      @map("student_id")
  sectionId Int      @map("section_id")
  assetId   Int?     @map("asset_id")
  openedAt  DateTime @default(now()) @map("opened_at")

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section       @relation("SectionAssetOpens", fields: [sectionId], references: [id], onDelete: Cascade)
  asset   NetdiskAsset? @relation("AssetOpens", fields: [assetId], references: [id], onDelete: SetNull)

  @@index([studentId, openedAt])
  @@map("student_asset_opens")
}
