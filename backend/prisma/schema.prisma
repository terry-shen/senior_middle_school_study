generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Student Management Models

model Class {
  id        Int       @id @default(autoincrement())
  name      String // 班级名称，如"高一(1)班"
  grade     String // 年级，如"高一"
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  students  Student[]

  @@map("classes")
}

model Student {
  id                    Int                      @id @default(autoincrement())
  studentId             String                   @unique @map("student_id") // 学号
  name                  String // 姓名
  passwordHash          String                   @map("password_hash") // 密码哈希
  classId               Int?                     @map("class_id") // 班级ID
  role                  String                   @default("student") // student, admin
  loginAttempts         Int                      @default(0) @map("login_attempts") // 登录尝试次数
  lockedUntil           DateTime?                @map("locked_until") // 锁定到期时间
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  class                 Class?                   @relation(fields: [classId], references: [id], onDelete: SetNull)
  sessions              Session[]
  learningProgress      StudentLearningProgress?

  @@index([studentId])
  @@index([classId])
  @@map("students")
  assetOpens StudentAssetOpen[]

}

